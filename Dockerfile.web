FROM node:22-alpine
WORKDIR /app

RUN npm install -g pnpm

# Salin file workspace (wajib)
COPY pnpm-workspace.yaml pnpm-lock.yaml ./

# Langsung salin folder apps dan packages
COPY apps/ ./apps/
COPY packages/ ./packages/

# Lanjut install
RUN pnpm install --frozen-lockfile

WORKDIR /app/apps/web

# Build aplikasi web (Nitro akan membuat folder .output)
RUN pnpm build

# Set environment variable agar Nitro berjalan di port 3000
ENV PORT=3000
ENV HOST=0.0.0.0
EXPOSE 3000

# Jalankan migrasi DB, lalu jalankan server produksi Nitro
CMD node migrate.mjs && node .output/server/index.mjs
